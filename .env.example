# Учётные данные root-пользователя MinIO.
# Скопируйте файл в .env и задайте свои значения.
MINIO_ROOT_USER=root
MINIO_ROOT_PASSWORD=rootpassword

# Параметры подключения приложения к хранилищу
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=utilities

# Учётные данные PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=utilities

# HTTP-сервер приложения
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080

# Секрет подписи JWT
JWT_SECRET=utilities-secret

# Redis — чёрный список JWT
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=password
