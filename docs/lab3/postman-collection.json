{
  "info": {
    "name": "Utilities — ЛР-3 REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET список услуг с фильтром",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8090/api/utilities?tariff=10",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "utilities?tariff=10"
          ],
          "query": [
            {
              "key": "tariff",
              "value": "10",
              "description": "тариф не выше, руб."
            }
          ]
        }
      }
    },
    {
      "name": "2. POST добавить услугу с картинкой и видео",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "http://localhost:8090/api/utilities",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "utilities"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Домофон",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": []
            },
            {
              "key": "video",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "3. GET черновик",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8090/api/utilities/draft",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "utilities",
            "draft"
          ]
        }
      }
    },
    {
      "name": "4. PUT опубликовать услугу",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8090/api/utilities/1",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "utilities",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Обслуживание домофона подъезда\",\n  \"tariffRate\": 45,\n  \"consumptionNorm\": 1,\n  \"measurementUnit\": \"кв.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. GET лента",
      "request": {
        "method": "GET",
        "description": "Лента по id: /utilities/feed/1?next=true — следующая после id. Лента без id (как из панели вкладок): удалить из адреса «/:id?next=true», останется http://localhost:8090/api/utilities/feed.",
        "url": {
          "raw": "http://localhost:8090/api/utilities/feed/:id?next=true",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "utilities",
            "feed",
            ":id?next=true"
          ],
          "query": [
            {
              "key": "next",
              "value": "true",
              "description": "следующая после id"
            }
          ],
          "variable": [
            {
              "key": "id",
              "value": "1",
              "description": "id услуги"
            }
          ]
        }
      }
    },
    {
      "name": "6. POST лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8090/api/utilities/1/like",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "utilities",
            "1",
            "like"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. DELETE удалить услугу",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:8090/api/utilities/1",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "utilities",
            "1"
          ]
        }
      }
    },
    {
      "name": "8. POST регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8090/api/users/register",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "users",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"newuser\",\n  \"password\": \"secret\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. POST аутентификация (заглушка)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "http://localhost:8090/api/users/login",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "users",
            "login"
          ]
        }
      }
    },
    {
      "name": "10. POST деавторизация (заглушка)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "http://localhost:8090/api/users/logout",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "users",
            "logout"
          ]
        }
      }
    }
  ]
}
